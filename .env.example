# PostgreSQL
DATABASE_URL=postgresql://matcha:matcha@localhost:5432/matcha

# Generate a unique value with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Public application URL used in verification and reset emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (use a verified sender in production)
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL=CY//MATCH <noreply@example.com>
